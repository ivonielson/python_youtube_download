# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# Chave secreta para proteger a API — OBRIGATÓRIO trocar antes de usar em produção
API_KEY=fasttube-mude-esta-chave-agora

# Máximo de downloads simultâneos
MAX_CONCURRENT_DOWNLOADS=3

# Origens permitidas no CORS (* = todas)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_DOWNLOAD=10/minute
